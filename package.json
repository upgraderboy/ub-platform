{
  "name": "ub-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Next-generation tech showcase, agency engine and cross-platform mobile ecosystem for Upgrader Boy",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "bash scripts/verify-all.sh",
    "audit:security": "bash scripts/security-audit.sh",
    "test:smoke": "bun run scripts/smoke-test.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.3.14"
}
